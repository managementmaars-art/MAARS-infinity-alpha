# MAARS Infinity - Backend Environment Variables
# Copy this file to .env and fill in your actual values

# ==================== DATABASE ====================
MONGO_URL=mongodb://localhost:27017
DB_NAME=maars_infinity

# ==================== JWT & AUTHENTICATION ====================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION_HOURS=24
SESSION_TIMEOUT_MINUTES=1440

# ==================== SERVER CONFIGURATION ====================
SERVER_PORT=8000
ENVIRONMENT=development
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100
ALLOWED_UPLOAD_TYPES=pdf,doc,docx,txt,json,xlsx,csv

# ==================== LLM PROVIDERS ====================
EMERGENT_LLM_KEY=your-emergent-llm-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key
GROQ_API_KEY=your-groq-api-key
COHERE_API_KEY=your-cohere-api-key

# ==================== INTEGRATIONS ====================
# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_NAME=MAARS Infinity

# Stripe
STRIPE_API_KEY=your-stripe-api-key

# Calendar integrations
GOOGLE_CALENDAR_API_KEY=your-google-calendar-api-key
MICROSOFT_CALENDAR_API_KEY=your-microsoft-calendar-api-key

# Web search and scraping
DUCKDUCKGO_ENABLED=true
SERPER_API_KEY=optional-serper-api-key
BRIGHTDATA_API_KEY=optional-brightdata-api-key

# ==================== OBSERVABILITY & LOGGING ====================
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=optional-sentry-dsn-for-error-tracking

# ==================== CORS & SECURITY ====================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1
DEBUG=false

# ==================== OPTIONAL EXTERNAL SERVICES ====================
# AI Voice
ELEVENLABS_API_KEY=optional-elevenlabs-api-key

# Social media
TWITTER_API_KEY=optional
LINKEDIN_API_KEY=optional

# AWS S3 (for uploads if not using local filesystem)
AWS_ACCESS_KEY_ID=optional
AWS_SECRET_ACCESS_KEY=optional
AWS_S3_BUCKET_NAME=optional
AWS_REGION=us-east-1

# ==================== DEVELOPMENT SETTINGS ====================
# Only set these for local development
DB_SEED_ON_STARTUP=false
RESET_DB_ON_STARTUP=false
DEMO_MODE=false

# ==================== LLM PROVIDER KEYS ====================
# Only the ones you plan to route to need values. Router falls back
# automatically when a key is missing.

# Flagship / specialist
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
PERPLEXITY_API_KEY=

# Fast / open-source hosts
CEREBRAS_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
AI21_API_KEY=
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=

# Regional / Chinese-hosted
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
YI_API_KEY=
ZHIPU_API_KEY=
DOUBAO_API_KEY=
HYPERBOLIC_API_KEY=
UPSTAGE_API_KEY=

# New direct providers (replaced OpenRouter)
NOVITA_API_KEY=
LEPTON_API_KEY=
LAMBDA_API_KEY=
MINIMAX_API_KEY=
INCEPTION_API_KEY=
ARCEE_API_KEY=
REKA_API_KEY=

# Open-source aggregators
HUGGINGFACE_API_KEY=
LLAMA_API_KEY=
WRITER_API_KEY=
BYTEZ_API_KEY=
OPENROUTER_API_KEY=

# ==================== COST OPTIMIZATION LEVERS (env fallback for cost_config) ====================
# Flip the corresponding toggle in /admin/pricing-manager AND set the env vars
# to move the lever from "claimed" to "verified active" at deploy time.
MAARS_LOCAL_IMAGE_URL=
MAARS_SMTP_HOST=
TELNYX_API_KEY=
MAARS_PROXY_POOL=

# ==================== VAULT ENCRYPTION ====================
# Used to encrypt OAuth tokens + credentials at rest in db.credentials.
# Generate one for production: python -c "import secrets;print(secrets.token_urlsafe(32))"
MAARS_VAULT_KEY=
