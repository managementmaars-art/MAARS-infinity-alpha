# MAARS Infinity - Frontend Environment Variables
# Copy this file to .env.local and fill in your actual values

# Backend API endpoint
REACT_APP_BACKEND_URL=http://localhost:8000

# Environment
REACT_APP_ENVIRONMENT=development

# Optional: Analytics
REACT_APP_SENTRY_DSN=optional-sentry-dsn

# Optional: Feature flags
REACT_APP_ENABLE_VOICE=true
REACT_APP_ENABLE_VIDEO=true
REACT_APP_ENABLE_IMAGE_GENERATION=true
REACT_APP_ENABLE_WEB_SEARCH=true

# Optional: Google Analytics
REACT_APP_GOOGLE_ANALYTICS_ID=optional-ga-id
