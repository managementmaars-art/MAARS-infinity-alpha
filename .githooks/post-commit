#!/usr/bin/env bash
# MAARS · post-commit hook — append every commit to MEMORY.md's Commit log.
#
# Why: MEMORY.md is the project's living audit trail. Keeping it in sync with
# git requires discipline; this hook makes it automatic. It's idempotent
# (guards against re-adding the same commit), tolerant (never blocks a commit
# on failure), and won't trigger recursively because the post-commit update
# is amended into the working tree as an unstaged change, not another commit.
#
# Enable once per clone:
#     git config core.hooksPath .githooks
# (already done in the repo's .git/config for this checkout)

set -u

cd "$(git rev-parse --show-toplevel)" || exit 0

# Resolve the audit file. The canonical location is .claude/MEMORY.md; we also
# accept a project-root MEMORY.md for repos that keep it at top level.
for candidate in ".claude/MEMORY.md" "MEMORY.md"; do
    if [ -f "$candidate" ]; then
        memory="$candidate"
        break
    fi
done
[ -n "${memory:-}" ] || exit 0      # no audit file, nothing to update

hash=$(git rev-parse --short HEAD 2>/dev/null)    || exit 0
subject=$(git log -1 --pretty=%s HEAD 2>/dev/null) || exit 0
author=$(git log -1 --pretty=%an HEAD 2>/dev/null) || exit 0
stamp=$(date -u +"%Y-%m-%d %H:%MZ")

# Skip if this commit was already logged (idempotency guard). The hash is
# written between backticks in the log, so search for the fenced form.
if grep -Fq "\`$hash\`" "$memory" 2>/dev/null; then
    exit 0
fi

# Ensure the Commit log section exists; create once if missing.
if ! grep -q '^## Commit log' "$memory" 2>/dev/null; then
    printf '\n\n---\n\n## Commit log\n\n_Auto-appended by `.githooks/post-commit`. Newest commits first._\n\n' >> "$memory"
fi

# Insert the new entry right after the "_Auto-appended by_" marker line so the
# newest commit stays at the top of the log. Portable across BSD/GNU sed by
# using awk.
line="- $stamp · \`$hash\` · ${subject//|/\\|} · _${author}_"
tmp=$(mktemp) || exit 0
awk -v line="$line" '
    BEGIN { inserted = 0 }
    {
        print
        if (!inserted && $0 ~ /^_Auto-appended by/) {
            print ""
            print line
            inserted = 1
        }
    }
    END {
        # Fallback: if the marker disappeared, just append at EOF.
        if (!inserted) print line
    }
' "$memory" > "$tmp" && mv "$tmp" "$memory"

exit 0
